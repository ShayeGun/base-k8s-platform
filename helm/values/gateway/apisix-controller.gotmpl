deployment:
    nodeSelector:
        node-role.kubernetes.io/control-plane: ""

    tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule

    adcContainer:
        image:
            repository: ghcr.io/api7/adc
            tag: "0.27.1"


gatewayProxy:
    createDefault: true

    provider:
        controlPlane:
            auth:
                adminKey:
                    value: {{ .Values.gateway_api.admin.apikey | quote }}
